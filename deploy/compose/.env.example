POSTGRES_PASSWORD=replace-with-a-random-database-password
OPENTAG_BOOTSTRAP_ORGANIZATION_ID=org_local
OPENTAG_BOOTSTRAP_ORGANIZATION_NAME=Local OpenTag
OPENTAG_BOOTSTRAP_PAIRING_TOKEN=replace-with-at-least-16-random-characters
OPENTAG_FENCING_TOKEN_SECRET=replace-with-at-least-32-independent-random-characters
OPENTAG_LOGIN_THROTTLE_SECRET=replace-with-a-different-at-least-32-character-secret
OPENTAG_LOGIN_NETWORK_THROTTLE_MODE=direct-peer
OPENTAG_RECOVERY_PAIRING_TOKEN=replace-with-a-different-at-least-16-character-secret
OPENTAG_BOOTSTRAP_ADMIN_EMAIL=owner@example.com
OPENTAG_BOOTSTRAP_ADMIN_NAME=OpenTag Owner
OPENTAG_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
OPENTAG_PUBLIC_URL=http://127.0.0.1:3000
OPENTAG_BIND_ADDRESS=127.0.0.1
OPENTAG_ENVIRONMENT=local

# Host-side path only. The file must contain a 32-byte KEK (raw, 64-character
# hexadecimal, or base64 decoding to 32 bytes). Compose mounts it as a secret;
# the container receives no inline KEK environment variable. On native Linux,
# keep it under a mode-0700 directory and make it readable by container UID/GID
# 10001 (for example, mode 0444 inside that protected directory).
OPENTAG_RELAY_CONTENT_KEK_SOURCE_FILE=replace-with-path-to-32-byte-kek-file

# Required outside local development. Set this to the immutable 40-character
# source revision used to build the image.
OPENTAG_RELEASE_SHA=local

# Leave empty to keep GitHub ingress absent. When enabled, use at least 32
# random characters and configure public TLS before registering a webhook.
OPENTAG_GITHUB_INGRESS_MASTER_SECRET=

OPENTAG_DB_POOL_MAX=10
OPENTAG_JOB_LEASE_MS=30000
OPENTAG_JOB_POLL_MS=1000
OPENTAG_JOB_RETRY_MS=30000
OPENTAG_LOGIN_MAX_FAILURES=5
OPENTAG_LOGIN_NETWORK_MAX_FAILURES=50
OPENTAG_LOGIN_WINDOW_MS=300000
OPENTAG_LOGIN_LOCKOUT_MS=900000
